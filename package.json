{
  "name": "editor-siyuan",
  "version": "1.3.0",
  "description": "Open and edit the text files referenced by notes in a new SiYuan tab, styled like a code block",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/build-package.mjs",
    "icon": "node scripts/render-icon.mjs && node scripts/render-preview.mjs",
    "preview": "node scripts/render-preview.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "editor",
    "text",
    "code"
  ],
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "csso": "^5.0.5",
    "prettier": "^3.9.9",
    "uglify-js": "^3.19.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "archiver": "^7.0.1",
    "jsdom": "^27.4.0",
    "playwright": "^1.63.0",
    "sass-embedded": "^1.104.1",
    "sharp": "^0.35.5",
    "siyuan": "^1.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
